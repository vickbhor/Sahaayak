# Copy this file to .env in the backend/ directory and fill in real values.
# Never commit the actual .env file (it's already in .gitignore).

# --- Groq (LLM) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# --- Auth ---
# Any long random string. Used to sign JWTs -- keep this secret in production.
JWT_SECRET=change-this-to-a-long-random-secret

# --- OpenSearch (semantic symptom index) ---
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_INDEX=sahaayak-symptoms

# --- Semantic classifier ---
# Number of nearest neighbors used at query time. Tune this using the
# K-sweep table printed by build_semantic_index.py, then set the winning
# value here permanently.
SEMANTIC_K=5

# --- Fallback behavior ---
# If "true", the classifier skips OpenSearch entirely and runs in a
# degraded fallback mode (useful for local dev without Docker running).
FALLBACK_MODE=false
